PORT=5000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin login (required)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_TTL_MINUTES=10

# Set when running behind a reverse proxy so client IPs and secure cookies are correct
# (number of proxy hops, e.g. 1, or "true" / "loopback")
# TRUST_PROXY=1

# PDF splitter: where uploaded originals are kept and for how long
# PDF_UPLOAD_DIR=
# PDF_RETENTION_DAYS=7

# NODE_ENV=production

# Image compressor: where originals are kept, for how long, and the total size cap
# IMG_UPLOAD_DIR=
# IMG_RETENTION_DAYS=30
# IMG_MAX_STORE_MB=2048

# PDF signer: where the original/signed PDFs and signature images are kept
# SIGNER_UPLOAD_DIR=
# SIGNER_RETENTION_DAYS=30
# SIGNER_MAX_STORE_MB=2048

# Security guard: blocks scanners/brute force by IP and pushes an alert to your phone via ntfy.
# Pick a long random topic, subscribe to it in the ntfy app, keep it secret.
# SECURITY_NTFY_TOPIC=
# SECURITY_NTFY_URL=https://ntfy.sh
# SECURITY_BLOCK_HOURS=24
# SECURITY_SCAN_THRESHOLD=10
# SECURITY_ALLOW_IPS=
