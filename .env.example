PORT=5000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin login (required)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_TTL_MINUTES=10

# Set when running behind a reverse proxy so client IPs and secure cookies are correct
# (number of proxy hops, e.g. 1, or "true" / "loopback")
# TRUST_PROXY=1

# PDF splitter: where uploaded originals are kept and for how long
# PDF_UPLOAD_DIR=
# PDF_RETENTION_DAYS=7

# NODE_ENV=production
